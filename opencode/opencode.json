{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "plugins": [
    "opencode-cmd-provider"
  ],
  "agents": {
    "orchestrator": {
      "mode": "primary",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "software-architect", "effect": "allow" },
        { "action": "subagent", "resource": "go-developer", "effect": "allow" },
        { "action": "subagent", "resource": "java-developer", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-developer", "effect": "allow" },
        { "action": "subagent", "resource": "go-wasm-developer", "effect": "allow" },
        { "action": "subagent", "resource": "github-actions-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "git-expert", "effect": "allow" },
        { "action": "subagent", "resource": "ux-ui-designer", "effect": "allow" },
        { "action": "subagent", "resource": "test-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "technical-writer", "effect": "allow" },
        { "action": "subagent", "resource": "code-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "security-reviewer", "effect": "allow" }
      ]
    },
    "build": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "software-architect", "effect": "allow" },
        { "action": "subagent", "resource": "go-developer", "effect": "allow" },
        { "action": "subagent", "resource": "java-developer", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-developer", "effect": "allow" },
        { "action": "subagent", "resource": "go-wasm-developer", "effect": "allow" },
        { "action": "subagent", "resource": "github-actions-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "git-expert", "effect": "allow" },
        { "action": "subagent", "resource": "ux-ui-designer", "effect": "allow" },
        { "action": "subagent", "resource": "test-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "technical-writer", "effect": "allow" },
        { "action": "subagent", "resource": "code-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "security-reviewer", "effect": "allow" }
      ]
    },
    "plan": {
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "software-architect", "effect": "allow" },
        { "action": "subagent", "resource": "go-developer", "effect": "allow" },
        { "action": "subagent", "resource": "java-developer", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-developer", "effect": "allow" },
        { "action": "subagent", "resource": "go-wasm-developer", "effect": "allow" },
        { "action": "subagent", "resource": "github-actions-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "git-expert", "effect": "allow" },
        { "action": "subagent", "resource": "ux-ui-designer", "effect": "allow" },
        { "action": "subagent", "resource": "test-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "technical-writer", "effect": "allow" },
        { "action": "subagent", "resource": "code-reviewer", "effect": "allow" },
        { "action": "subagent", "resource": "security-reviewer", "effect": "allow" }
      ]
    },
    "software-architect": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "go-developer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "java-developer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "frontend-developer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "go-wasm-developer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "github-actions-engineer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "git-expert": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "ux-ui-designer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "test-engineer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "technical-writer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "code-reviewer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    },
    "security-reviewer": {
      "mode": "subagent",
      "permissions": [{ "action": "subagent", "resource": "*", "effect": "deny" }]
    }
  },
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": { "limit": { "context": 262144, "output": 384000 } },
        "deepseek-v4-pro": { "limit": { "context": 262144, "output": 384000 } },
        "glm-5.1": { "limit": { "context": 262144, "output": 32768 } },
        "glm-5.2": { "limit": { "context": 262144, "output": 131072 } },
        "glm-5.3": { "limit": { "context": 262144, "output": 131072 } },
        "gpt-5.6-luna": { "limit": { "context": 262144, "input": 262144, "output": 128000 } },
        "grok-4.5": { "limit": { "context": 262144, "output": 500000 } },
        "hy3": { "limit": { "context": 262144, "output": 64000 } },
        "kimi-k2.6": { "limit": { "context": 262144, "output": 65536 } },
        "kimi-k2.7-code": { "limit": { "context": 262144, "output": 262144 } },
        "kimi-k3": { "limit": { "context": 262144, "output": 131072 } },
        "mimo-v2.5": { "limit": { "context": 262144, "output": 128000 } },
        "mimo-v2.5-pro": { "limit": { "context": 262144, "output": 128000 } },
        "mimo-v2-pro": { "limit": { "context": 262144, "output": 128000 } },
        "minimax-m2.7": { "limit": { "context": 262144, "output": 131072 } },
        "minimax-m3": { "limit": { "context": 262144, "output": 131072 } },
        "muse-spark-1.2-contributor": { "limit": { "context": 262144, "output": 131072 } },
        "muse-spark-1.3": { "limit": { "context": 262144, "output": 131072 } },
        "qwen3.6-plus": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.7-max": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.7-plus": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.8-max": { "limit": { "context": 262144, "output": 131072 } }
      }
    }
  },
  "mcp": {
    "servers": {
      "obsidian": {
        "type": "local",
        "command": ["uvx", "mcp-obsidian"],
        "disabled": true,
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 30000 },
        "environment": {
          "OBSIDIAN_API_KEY": "{file:~/.config/opencode/.secrets/obsidian-api-key}",
          "OBSIDIAN_HOST": "127.0.0.1",
          "OBSIDIAN_PORT": "27124"
        }
      },
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": true,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-pat}"
        }
      },
      "sonarqube": {
        "type": "local",
        "command": ["podman", "run", "--init", "--pull=always", "-i", "--rm", "-e", "SONARQUBE_TOKEN", "-e", "SONARQUBE_URL", "sonarsource/sonarqube-mcp"],
        "disabled": true,
        "timeout": { "startup": 10000, "catalog": 10000, "execution": 10000 },
        "environment": {
          "SONARQUBE_URL": "https://sonar.controllan.de",
          "SONARQUBE_TOKEN": "{file:~/.config/opencode/.secrets/sonarqube-token}"
        }
      }
    }
  }
}
