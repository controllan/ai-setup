{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "permission": {
        "task": {
          "*": "deny",
          "general": "deny",
          "explore": "deny",
          "build": "deny",
          "plan": "deny",
          "software-architect": "allow",
          "go-developer": "allow",
          "java-developer": "allow",
          "frontend-developer": "allow",
          "go-wasm-developer": "allow",
          "github-actions-engineer": "allow",
          "git-expert": "allow",
          "ux-ui-designer": "allow",
          "test-engineer": "allow",
          "code-reviewer": "allow",
          "technical-writer": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "deny",
          "explore": "deny",
          "software-architect": "allow",
          "go-developer": "allow",
          "java-developer": "allow",
          "frontend-developer": "allow",
          "go-wasm-developer": "allow",
          "github-actions-engineer": "allow",
          "git-expert": "allow",
          "ux-ui-designer": "allow",
          "test-engineer": "allow",
          "code-reviewer": "allow",
          "technical-writer": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "general": "deny",
          "explore": "deny",
          "software-architect": "allow",
          "go-developer": "allow",
          "java-developer": "allow",
          "frontend-developer": "allow",
          "go-wasm-developer": "allow",
          "github-actions-engineer": "allow",
          "git-expert": "allow",
          "ux-ui-designer": "allow",
          "test-engineer": "allow",
          "code-reviewer": "allow",
          "technical-writer": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "software-architect": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "go-developer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "java-developer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "frontend-developer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "go-wasm-developer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "github-actions-engineer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "git-expert": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "ux-ui-designer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "test-engineer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "technical-writer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    },
    "security-reviewer": {
      "mode": "subagent",
      "permission": {
        "task": "deny"
      }
    }
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": { "limit": { "context": 262144, "output": 384000 } },
        "deepseek-v4-pro": { "limit": { "context": 262144, "output": 384000 } },
        "glm-5.1": { "limit": { "context": 262144, "output": 32768 } },
        "glm-5.2": { "limit": { "context": 262144, "output": 131072 } },
        "glm-5.3": { "limit": { "context": 262144, "output": 131072 } },
        "gpt-5.6-luna": { "limit": { "context": 262144, "input": 262144, "output": 128000 } },
        "grok-4.5": { "limit": { "context": 262144, "output": 500000 } },
        "hy3": { "limit": { "context": 262144, "output": 64000 } },
        "kimi-k2.6": { "limit": { "context": 262144, "output": 65536 } },
        "kimi-k2.7-code": { "limit": { "context": 262144, "output": 262144 } },
        "kimi-k3": { "limit": { "context": 262144, "output": 131072 } },
        "mimo-v2.5": { "limit": { "context": 262144, "output": 128000 } },
        "mimo-v2.5-pro": { "limit": { "context": 262144, "output": 128000 } },
        "mimo-v2-pro": { "limit": { "context": 262144, "output": 128000 } },
        "minimax-m2.7": { "limit": { "context": 262144, "output": 131072 } },
        "minimax-m3": { "limit": { "context": 262144, "output": 131072 } },
        "muse-spark-1.2-contributor": { "limit": { "context": 262144, "output": 131072 } },
        "muse-spark-1.3": { "limit": { "context": 262144, "output": 131072 } },
        "qwen3.6-plus": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.7-max": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.7-plus": { "limit": { "context": 262144, "output": 65536 } },
        "qwen3.8-max": { "limit": { "context": 262144, "output": 131072 } }
      }
    }
  },
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["uvx", "mcp-obsidian"],
      "enabled": false,
      "timeout": 30000,
      "environment": {
        "OBSIDIAN_API_KEY": "{file:~/.config/opencode/.secrets/obsidian-api-key}",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-pat}"
      }
    }
  }
}
